<Window Style="{StaticResource {x:Type Window}}" x:Class="Marquee.Editor.Dialogs.CleanUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Marquee.Editor.Resources"
        Title="{x:Static res:Strings.CleanUpTitle}"
        Width="520" Height="440" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- The files nothing in layout.yaml names, each ticked to delete, with its size; Delete asks once more. -->
    <DockPanel Margin="16">
        <TextBlock x:Name="Intro" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button ToolTip="{x:Static res:Strings.SelectAllFilesTip}" DockPanel.Dock="Left" Content="{x:Static res:Strings.SelectAll}" Command="{Binding SelectAllCommand}" Padding="10,3" />
            <Button ToolTip="{x:Static res:Strings.SelectNoFilesTip}" DockPanel.Dock="Left" Content="{x:Static res:Strings.SelectNone}" Command="{Binding SelectNoneCommand}" Padding="10,3"
                    Margin="8,0,0,0" />
            <Button ToolTip="{x:Static res:Strings.CancelTip}" DockPanel.Dock="Right" Content="{x:Static res:Strings.Cancel}" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
            <Button ToolTip="{x:Static res:Strings.DeleteFilesTip}" DockPanel.Dock="Right" Content="{Binding DeleteText}" IsEnabled="{Binding CanDelete}" Padding="10,3" Click="OnDelete" />
        </DockPanel>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,3">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0" />
                                <CheckBox ToolTip="{x:Static res:Strings.SelectFileTip}" IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
