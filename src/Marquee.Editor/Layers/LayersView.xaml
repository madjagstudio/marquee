<UserControl x:Class="Marquee.Editor.Layers.LayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Marquee.Editor.Resources"
             Focusable="True" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource RedColor}" />

            <!-- The eye and the lock: a glyph button that shows its state; the code-behind writes the change. -->
            <Style x:Key="FlagButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{StaticResource Clear}" />
                <Setter Property="BorderBrush" Value="{StaticResource Clear}" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- One row: the fold arrow for a group, the icon, the name (or the rename box), a read-only note, the eye and
                 the lock; lines above, below or around it while a drag would drop there. -->
            <DataTemplate x:Key="LayerRow">
                <Border x:Name="Row" Height="24" Background="{StaticResource Clear}" AllowDrop="True"
                        MouseLeftButtonDown="OnRowDown" MouseMove="OnRowMove" MouseLeftButtonUp="OnRowUp"
                        MouseRightButtonDown="OnRowRightDown"
                        DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                    <Grid>
                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource Accent}"
                                   Visibility="{Binding DropAbove, Converter={StaticResource Visible}}" />
                        <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Accent}"
                                   Visibility="{Binding DropBelow, Converter={StaticResource Visible}}" />
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding DropInto, Converter={StaticResource Visible}}" />
                        <DockPanel Margin="{Binding Indent}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlagButton}" Click="OnLockClick"
                                    IsEnabled="{Binding IsEditable}">
                                <Button.ToolTip>
                                    <TextBlock x:Name="LockTip" Text="{x:Static res:Strings.LockTip}" />
                                </Button.ToolTip>
                                <TextBlock x:Name="LockGlyph" Text="&#xE785;" Opacity="0.45" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlagButton}" Click="OnHideClick"
                                    IsEnabled="{Binding IsEditable}">
                                <Button.ToolTip>
                                    <TextBlock x:Name="HideTip" Text="{x:Static res:Strings.HideTip}" />
                                </Button.ToolTip>
                                <TextBlock x:Name="EyeGlyph" Text="&#xE7B3;" />
                            </Button>
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static res:Strings.ReadOnlyLayer}" Foreground="{StaticResource TextMuted}"
                                       FontSize="11" VerticalAlignment="Center" Margin="4,0"
                                       ToolTip="{x:Static res:Strings.ReadOnlyLayerTip}"
                                       Visibility="Collapsed"
                                       x:Name="ReadOnlyNote" />
                            <Button ToolTip="{x:Static res:Strings.FoldLayerTip}" x:Name="Fold" DockPanel.Dock="Left" Width="16" Padding="0" Background="{StaticResource Clear}"
                                    BorderBrush="{StaticResource Clear}" Focusable="False" Click="OnFoldClick" Visibility="Hidden"
                                    FontSize="9" Foreground="{StaticResource TextMuted}" Content="▼" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" Width="18"
                                       TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            <Grid Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBox ToolTip="{x:Static res:Strings.RenameLayerTip}" x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="1,0"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                                         IsVisibleChanged="OnRenameShown" KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource RedDeep}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsNamed}" Value="False">
                        <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                        <Setter TargetName="NameText" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                        <Setter TargetName="EyeGlyph" Property="Text" Value="&#xED1A;" />
                        <Setter TargetName="NameText" Property="Opacity" Value="0.5" />
                        <Setter TargetName="HideTip" Property="Text" Value="{x:Static res:Strings.ShowTip}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Locked}" Value="True">
                        <Setter TargetName="LockGlyph" Property="Text" Value="&#xE72E;" />
                        <Setter TargetName="LockGlyph" Property="Opacity" Value="1" />
                        <Setter TargetName="LockTip" Property="Text" Value="{x:Static res:Strings.UnlockTip}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter TargetName="Fold" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                        <Setter TargetName="Fold" Property="Content" Value="▶" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditable}" Value="False">
                        <Setter TargetName="ReadOnlyNote" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.FocusVisualStyle><StaticResource ResourceKey="KeyboardFocus" /></UserControl.FocusVisualStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="WidgetList" ItemsSource="{Binding Widgets}" ItemTemplate="{StaticResource LayerRow}" Margin="6,0" />
        </ScrollViewer>
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource Line}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <!-- Background rows have their own add menu and scroll within their resizable section. -->
        <DockPanel x:Name="BackgroundSection" Grid.Row="2">
            <Border DockPanel.Dock="Top" Padding="10,4,10,2">
                <TextBlock Text="{x:Static res:Strings.BackgroundSection}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"
                           ToolTip="{x:Static res:Strings.BackgroundSectionTip}" />
            </Border>
            <Menu DockPanel.Dock="Top" Background="{StaticResource Clear}" Margin="6,4" IsEnabled="{Binding CanEdit}">
                <MenuItem ToolTip="{x:Static res:Strings.AddLayerTip}" Header="{x:Static res:Strings.AddLayerMenu}">
                    <MenuItem ToolTip="{x:Static res:Strings.AddFillLayerTip}" Header="{x:Static res:Strings.LayerFill}" Command="{Binding AddFillLayerCommand}" />
                    <MenuItem ToolTip="{x:Static res:Strings.AddImageTip}" Header="{x:Static res:Strings.AddLayerImage}" Command="{Binding AddImageLayerCommand}" />
                    <MenuItem ToolTip="{x:Static res:Strings.AddVideoTip}" Header="{x:Static res:Strings.AddLayerVideo}" Command="{Binding AddVideoLayerCommand}" />
                    <MenuItem ToolTip="{x:Static res:Strings.AddShaderLayerTip}" Header="{x:Static res:Strings.AddLayerShader}" Command="{Binding AddShaderLayerCommand}" />
                </MenuItem>
            </Menu>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="BackgroundList" ItemsSource="{Binding Background}" ItemTemplate="{StaticResource LayerRow}" Margin="6,0,6,4" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
