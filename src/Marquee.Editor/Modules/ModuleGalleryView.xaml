<Window x:Class="Marquee.Editor.Modules.ModuleGalleryView" Style="{StaticResource {x:Type Window}}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:res="clr-namespace:Marquee.Editor.Resources" Title="{x:Static res:Strings.ModuleGallery}" Width="880" Height="560" WindowStartupLocation="CenterOwner">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></Window.Resources>
 <TabControl ItemsSource="{Binding Categories}" Margin="12">
  <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></TabControl.ItemTemplate>
  <TabControl.ContentTemplate><DataTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <ItemsControl ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Button Margin="4" Padding="6" Click="OnAdd" PreviewMouseLeftButtonDown="OnPress" PreviewMouseMove="OnMove" ContextMenuOpening="OnModuleMenu" ToolTip="{x:Static res:Strings.AddModuleTip}">
     <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
     <StackPanel><Image Source="{Binding Bitmap}" Width="240" Height="140" /><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" /></StackPanel>
    </Button></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <ItemsControl Visibility="{Binding IsBlank, Converter={StaticResource Visible}}" ItemsSource="{Binding DataContext.BlankWidgets, RelativeSource={RelativeSource AncestorType=Window}}">
    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" ToolTip="{Binding ToolTip}" Click="OnBlank" /></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel></ScrollViewer></DataTemplate></TabControl.ContentTemplate>
 </TabControl>
</Window>
