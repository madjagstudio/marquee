<UserControl x:Class="Marquee.Editor.Controls.ValuePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Marquee.Editor.Resources"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <CollectionViewSource x:Key="SensorGroups" Source="{Binding Keys}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="CategoryName" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
            <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="3,1" />
                <Setter Property="MinWidth" Value="35" />
                <EventSetter Event="LostKeyboardFocus" Handler="OnValueLostFocus" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                        <Setter Property="ToolTip" Value="{Binding Problem}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <ComboBox ToolTip="{x:Static res:Strings.PickerModeTip}" ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Mode"
                  SelectedValue="{Binding Mode}" Margin="0,0,0,3" Visibility="{Binding ShowModes, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="{x:Static res:Strings.PickerMode}" />
        <StackPanel Visibility="{Binding IsSensor, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static res:Strings.PickerSearch}" />
            <TextBox ToolTip="{x:Static res:Strings.PickerSearchTip}" x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:Strings.PickerSearch}" Padding="3,1" />
            <ListBox ItemsSource="{Binding Source={StaticResource SensorGroups}}" SelectedValuePath="Key" SelectedValue="{Binding SelectedKey}"
                     IsSynchronizedWithCurrentItem="False"
                     Height="280" Margin="0,3" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="{x:Static res:Strings.PickerSensor}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander Header="{Binding Name}" IsExpanded="True" HorizontalContentAlignment="Stretch" ToolTip="{x:Static res:Strings.SensorGroupTip}">
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReading}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MaxWidth="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <UniformGrid Columns="2" Visibility="{Binding ShowRange, Converter={StaticResource Visible}}">
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="{x:Static res:Strings.PickerFromLow}" />
                    <TextBox ToolTip="{x:Static res:Strings.PickerFromLowTip}" Style="{StaticResource ValueBox}" Text="{Binding FromLow, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerFromLow}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PickerFromHigh}" />
                    <TextBox ToolTip="{x:Static res:Strings.PickerFromHighTip}" Style="{StaticResource ValueBox}" Text="{Binding FromHigh, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerFromHigh}" />
                </StackPanel>
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="{x:Static res:Strings.PickerToLow}" />
                    <TextBox ToolTip="{x:Static res:Strings.PickerToLowTip}" Style="{StaticResource ValueBox}" Text="{Binding ToLow, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerToLow}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PickerToHigh}" />
                    <TextBox ToolTip="{x:Static res:Strings.PickerToHighTip}" Style="{StaticResource ValueBox}" Text="{Binding ToHigh, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerToHigh}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
        <TextBox ToolTip="{x:Static res:Strings.PickerNumberTip}" Style="{StaticResource ValueBox}" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsNumber, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static res:Strings.PickerNumber}" />
        <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding AdvancedSummary}" TextWrapping="Wrap" />
            <Expander x:Name="RawExpression" ToolTip="{x:Static res:Strings.RawSectionTip}">
                <Expander.Header><TextBlock Text="{x:Static res:Strings.RawSection}" TextWrapping="Wrap" /></Expander.Header>
                <TextBox ToolTip="{x:Static res:Strings.PickerAdvancedTip}" Style="{StaticResource ValueBox}" Text="{Binding AdvancedText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource LabelFont}"
                         TextWrapping="Wrap" AutomationProperties.Name="{x:Static res:Strings.PickerAdvanced}" />
            </Expander>
        </StackPanel>
        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                   Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
