<UserControl x:Class="Marquee.Editor.Controls.ValuePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Marquee.Editor.Resources"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="MinWidth" Value="35" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnValueLostFocus" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter Property="Foreground" Value="#FFB3261E" />
                    <Setter Property="BorderBrush" Value="#FFB3261E" />
                    <Setter Property="ToolTip" Value="{Binding Problem}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Mode"
                  SelectedValue="{Binding Mode}" Margin="0,0,0,3"
                  AutomationProperties.Name="{x:Static res:Strings.PickerMode}" />
        <StackPanel Visibility="{Binding IsSensor, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static res:Strings.PickerSearch}" />
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static res:Strings.PickerSearch}" Padding="3,1" />
            <ListBox ItemsSource="{Binding Keys}" SelectedValuePath="Key" SelectedValue="{Binding SelectedKey}"
                     MaxHeight="120" Margin="0,3" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{x:Static res:Strings.PickerSensor}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Key}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding ValueText}" Margin="8,0,0,0" Foreground="#FF9AA0A6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <UniformGrid Columns="2" Visibility="{Binding ShowRange, Converter={StaticResource Visible}}">
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="{x:Static res:Strings.PickerFromLow}" />
                    <TextBox Style="{StaticResource ValueBox}" Text="{Binding FromLow, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerFromLow}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PickerFromHigh}" />
                    <TextBox Style="{StaticResource ValueBox}" Text="{Binding FromHigh, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerFromHigh}" />
                </StackPanel>
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="{x:Static res:Strings.PickerToLow}" />
                    <TextBox Style="{StaticResource ValueBox}" Text="{Binding ToLow, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerToLow}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PickerToHigh}" />
                    <TextBox Style="{StaticResource ValueBox}" Text="{Binding ToHigh, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static res:Strings.PickerToHigh}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
        <TextBox Style="{StaticResource ValueBox}" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsNumber, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static res:Strings.PickerNumber}" />
        <TextBox Style="{StaticResource ValueBox}" Text="{Binding AdvancedText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                 Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static res:Strings.PickerAdvanced}" />
        <TextBlock Text="{Binding Problem}" Foreground="#FFB3261E" TextWrapping="Wrap"
                   Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
