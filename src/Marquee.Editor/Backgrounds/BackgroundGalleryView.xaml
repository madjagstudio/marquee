<Window x:Class="Marquee.Editor.Backgrounds.BackgroundGalleryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:res="clr-namespace:Marquee.Editor.Resources" Title="{x:Static res:Strings.BackgroundGallery}" Width="820" Height="430" WindowStartupLocation="CenterOwner">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <StackPanel Margin="16">
  <TextBlock Text="{x:Static res:Strings.MovingBackgrounds}" />
  <ItemsControl ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><Button Margin="4" Padding="4" Click="OnMoving" ToolTip="{x:Static res:Strings.UseBackgroundTip}"><StackPanel><Image Source="{Binding Bitmap}" Width="240" Height="60" /><TextBlock Text="{Binding Name}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{x:Static res:Strings.StillBackgrounds}" Margin="0,12,0,4" />
  <WrapPanel>
   <Button Content="{x:Static res:Strings.StillColour}" Tag="Fill" Click="OnStill" ToolTip="{x:Static res:Strings.AddFillLayerTip}" />
   <Button Content="{x:Static res:Strings.StillGradient}" Tag="Gradient" Click="OnStill" ToolTip="{x:Static res:Strings.AddFillLayerTip}" />
   <Button Content="{x:Static res:Strings.StillPicture}" Tag="Image" Click="OnStill" ToolTip="{x:Static res:Strings.AddImageTip}" />
   <Button Content="{x:Static res:Strings.StillVideo}" Tag="Video" Click="OnStill" ToolTip="{x:Static res:Strings.AddVideoTip}" />
  </WrapPanel>
  <TextBlock Text="{x:Static res:Strings.MoreBackgrounds}" Margin="0,12,0,4" />
  <Button Content="{x:Static res:Strings.ImportBackgroundShader}" Tag="Shader" Click="OnStill" ToolTip="{x:Static res:Strings.AddShaderLayerTip}" HorizontalAlignment="Left" />
 </StackPanel>
</Window>
