<UserControl x:Class="Marquee.Editor.Styles.StylesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Marquee.Editor.Resources"
             Focusable="True" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,4">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.NewStyle}" Command="{Binding NewCommand}" Padding="8,1" />
            <TextBlock Text="{x:Static res:Strings.StylesSection}" FontWeight="SemiBold" Foreground="#FF5F6368" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Items}" Margin="6,0,6,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Background="Transparent" Padding="4,3"
                                MouseLeftButtonDown="OnRowDown" MouseRightButtonDown="OnRowRightDown">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedBy}" Foreground="#FF5F6368" Margin="6,0,0,0" />
                                    <Grid>
                                        <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBox x:Name="Rename" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="1,0"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                                                 IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 IsVisibleChanged="OnRenameShown" KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" />
                                    </Grid>
                                </DockPanel>
                                <TextBlock x:Name="Problem" Text="{Binding Problem}" Foreground="#FFB3261E" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FFD2E3FC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="Name" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Problem" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                <Setter TargetName="Rename" Property="BorderBrush" Value="#FFB3261E" />
                                <Setter TargetName="Rename" Property="Foreground" Value="#FFB3261E" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
