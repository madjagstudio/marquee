<UserControl x:Class="Marquee.Editor.Properties.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Marquee.Editor.Properties"
             xmlns:res="clr-namespace:Marquee.Editor.Resources">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <local:PropertyTemplateSelector x:Key="Templates" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel IsEnabled="{Binding CanEdit}">
        <TextBlock Text="{x:Static res:Strings.RulesSection}" FontWeight="SemiBold" Margin="0,8,0,4" />
        <TextBlock Text="{x:Static res:Strings.RulesTip}" TextWrapping="Wrap" Margin="0,0,0,4" />
        <StackPanel Visibility="{Binding HasTryValue, Converter={StaticResource Visible}}" Margin="0,4">
            <DockPanel>
                <TextBlock Text="{x:Static res:Strings.TryValue}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TrySourceName}" TextWrapping="Wrap" Margin="8,0,0,0" />
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Unpin}" ToolTip="{x:Static res:Strings.UnpinTip}"
                        Command="{Binding UnpinCommand}" Margin="6,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding TryDisplay}" MinWidth="55" Margin="6,0" VerticalAlignment="Center" />
                <Slider x:Name="TryValueSlider" Minimum="{Binding TryMin}" Maximum="{Binding TryMax}"
                        Value="{Binding TryNumber, Mode=OneWay}" ValueChanged="OnTryValueChanged"
                        ToolTip="{x:Static res:Strings.TryValueTip}" />
            </DockPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,4" AllowDrop="True" Drop="OnDrop">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="☰" Padding="4" Cursor="SizeAll" ToolTip="{x:Static res:Strings.RuleDrag}"
                                           PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove" />
                                <TextBlock Text="{x:Static res:Strings.RuleWhen}" VerticalAlignment="Center" Margin="2" />
                                <ComboBox ToolTip="{x:Static res:Strings.RuleConditionTip}" ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" MinWidth="65" Margin="2" />
                                <TextBox ToolTip="{x:Static res:Strings.RuleValueTip}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="2"
                                         Visibility="{Binding NeedsValue, Converter={StaticResource Visible}}"
                                         KeyDown="OnValueKey" LostKeyboardFocus="OnValueLostFocus" />
                                <TextBlock Text="{x:Static res:Strings.RuleUse}" VerticalAlignment="Center" Margin="2"
                                           Visibility="{Binding IsWidget, Converter={StaticResource Visible}}" />
                                <ComboBox ToolTip="{x:Static res:Strings.RuleStyleTip}" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}" DisplayMemberPath="Label" MinWidth="90" Margin="2"
                                          Visibility="{Binding IsWidget, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{x:Static res:Strings.RuleSet}" VerticalAlignment="Center" Margin="2"
                                           Visibility="{Binding IsRing, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{x:Static res:Strings.RuleOn}" Foreground="{StaticResource Text}" FontWeight="Bold" Margin="4"
                                           Visibility="{Binding IsMatching, Converter={StaticResource Visible}}" />
                                <Button ToolTip="{x:Static res:Strings.DeleteRuleTip}" Content="{x:Static res:Strings.RuleDelete}" Command="{Binding DeleteCommand}" Margin="2" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding RingRows}" ItemTemplateSelector="{StaticResource Templates}"
                                          Visibility="{Binding IsRing, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding Properties.Sections}" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander ToolTip="{x:Static res:Strings.RuleSectionTip}" Header="{Binding Title}" IsExpanded="True">
                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource Templates}" Margin="4,0,0,0" />
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button ToolTip="{x:Static res:Strings.AddRuleTip}" Content="{x:Static res:Strings.AddRule}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,4" />
    </StackPanel>
</UserControl>
