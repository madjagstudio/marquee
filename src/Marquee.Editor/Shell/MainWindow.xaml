<Window Style="{StaticResource {x:Type Window}}" x:Class="Marquee.Editor.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="clr-namespace:Marquee.Editor.Canvas"
        xmlns:res="clr-namespace:Marquee.Editor.Resources"
        Title="{Binding Title}"
        Width="1400" Height="860" MinWidth="960" MinHeight="480"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MarqueeEditor;component/Theme/MadJag.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Background" Value="{StaticResource Clear}" />
                <Setter Property="BorderBrush" Value="{StaticResource Clear}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="Divider" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="10,8,10,4" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- The window bar; the secondary toolbar keeps all editing commands within reach. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Window}" BorderBrush="{StaticResource RedDeep}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <WrapPanel>
                    <Menu DockPanel.Dock="Left" IsMainMenu="False" Background="{StaticResource Clear}" VerticalAlignment="Center">
                        <MenuItem x:Name="ThemeMenu" SubmenuOpened="OnThemeMenuOpened" ToolTip="{x:Static res:Strings.ThemePickerTip}">
                            <MenuItem.Header>
                                <TextBlock Text="{Binding ThemeHeading}" FontFamily="{StaticResource HeadFont}" FontSize="20" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            </MenuItem.Header>
                            <MenuItem IsEnabled="False" ToolTip="{x:Static res:Strings.ThemePickerTip}" />
                        </MenuItem>
                    </Menu>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GlyphButton}" Content="&#xE7A7;"
                            Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" AutomationProperties.Name="{x:Static res:Strings.Undo}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource GlyphButton}" Content="&#xE7A6;"
                            Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" AutomationProperties.Name="{x:Static res:Strings.Redo}" />
                    <Menu DockPanel.Dock="Left" IsMainMenu="False" Background="{StaticResource Clear}" VerticalAlignment="Center">
                        <MenuItem x:Name="SaveMenu" ToolTip="{x:Static res:Strings.SaveDetailsTip}">
                            <MenuItem.Header><TextBlock Text="{Binding SaveText}" Foreground="{StaticResource TextMuted}" /></MenuItem.Header>
                        </MenuItem>
                    </Menu>
                    <ToggleButton x:Name="LayersToggle" DockPanel.Dock="Left" Content="{x:Static res:Strings.LayersPanel}" IsChecked="{Binding IsLayersOpen, Mode=TwoWay}"
                                  ToolTip="{x:Static res:Strings.LayersToggleTip}" Margin="8,0" Padding="10,4" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScreenTag" DockPanel.Dock="Left" Text="{Binding ScreenTag}" FontFamily="{StaticResource LabelFont}"
                               ToolTip="{Binding ScreenToolTip}" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScreenMismatch}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static res:Strings.ShowOnScreen}"
                            Command="{Binding ShowOnScreenCommand}" ToolTip="{x:Static res:Strings.ShowOnScreenTip}" Margin="8,0" />
                </WrapPanel>
                <DockPanel LastChildFill="False" Margin="0,4,0,0">
                    <Menu DockPanel.Dock="Left" IsMainMenu="False" Background="{StaticResource Clear}" VerticalAlignment="Center">
                        <MenuItem ToolTip="{x:Static res:Strings.AddModuleTip}" x:Name="AddWidgetMenu" Header="{x:Static res:Strings.AddModule}" Command="{Binding ModuleGalleryCommand}" />
                        <MenuItem ToolTip="{x:Static res:Strings.ArrangeTip}" x:Name="ArrangeMenu" Header="{x:Static res:Strings.Align}" />
                    </Menu>
                    <Separator DockPanel.Dock="Left" Style="{StaticResource Divider}" />
                    <Button ToolTip="{x:Static res:Strings.ZoomFitTip}" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="{x:Static res:Strings.ZoomFit}"
                            Command="{Binding ZoomCommand}" CommandParameter="{x:Static canvas:ZoomMode.Fit}" />
                    <Button ToolTip="{x:Static res:Strings.ZoomActualTip}" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="{x:Static res:Strings.Zoom100}"
                            Command="{Binding ZoomCommand}" CommandParameter="{x:Static canvas:ZoomMode.Actual}" />
                    <Button ToolTip="{x:Static res:Strings.ZoomDoubleTip}" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="{x:Static res:Strings.Zoom200}"
                            Command="{Binding ZoomCommand}" CommandParameter="{x:Static canvas:ZoomMode.Double}" />
                    <Menu DockPanel.Dock="Right" IsMainMenu="False" Background="{StaticResource Clear}" VerticalAlignment="Center">
                        <MenuItem ToolTip="{x:Static res:Strings.ProblemsTip}" x:Name="ProblemsMenu">
                            <MenuItem.Header><TextBlock Text="{Binding ProblemsText}" /></MenuItem.Header>
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </StackPanel>
        </Border>
        <!-- The status bar: the last message, whether the tray is running, the zoom. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Window}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Canvas.ZoomText}" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:Strings.TrayNotRunning}" Foreground="{StaticResource TextMuted}"
                           ToolTip="{x:Static res:Strings.TrayNotRunningTip}"
                           Visibility="{Binding TrayNotRunning, Converter={StaticResource Visible}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RecoveryProblem}" Foreground="{StaticResource Warning}" Margin="0,0,12,0"
                           MaxWidth="480" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecoveryProblem}" />
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <!-- The banner: editing paused on a file that doesn't load, or a read-only theme. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Warning}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasBanner, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button ToolTip="{x:Static res:Strings.KeepEditingTip}" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0" Content="{x:Static res:Strings.KeepEditing}"
                        Command="{Binding KeepEditingCommand}" Visibility="{Binding CanKeepEditing, Converter={StaticResource Visible}}" />
                <Button ToolTip="{x:Static res:Strings.RevertTip}" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0" Content="{x:Static res:Strings.RevertToOpened}"
                        Command="{Binding RevertCommand}" Visibility="{Binding CanRevert, Converter={StaticResource Visible}}" />
                <Button ToolTip="{x:Static res:Strings.MakeCopyTip}" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0" Content="{x:Static res:Strings.MakeCopyToEdit}"
                        Command="{Binding MakeCopyCommand}" Visibility="{Binding CanMakeCopy, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Layers and Background share their existing view, with Styles below; the canvas is central. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftPanelWidth, Mode=TwoWay}">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="MinWidth" Value="200" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLayersOpen}" Value="False">
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="240" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="LeftPanel" Grid.Column="0" Background="{StaticResource Panel}" Visibility="{Binding IsLayersOpen, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="164" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="64" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{x:Static res:Strings.LayersPanel}" />
                    <ContentControl x:Name="LayersPanel" Focusable="False" />
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource Line}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                <ContentControl x:Name="StylesPanel" Grid.Row="2" Focusable="False" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Visibility="{Binding IsLayersOpen, Converter={StaticResource Visible}}"
                          Background="{StaticResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <canvas:CanvasView x:Name="CanvasArea" Grid.Column="2" DataContext="{Binding Canvas}" />
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Line}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Column="4" Background="{StaticResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{x:Static res:Strings.PropertiesPanel}" />
                    <ContentControl x:Name="PropertiesPanel" Focusable="False" />
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource Line}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="{x:Static res:Strings.TestValuesPanel}" />
                    <ContentControl x:Name="TestValuesPanel" Focusable="False" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
