<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Resources are named from the root namespace and their folder: Resources\Strings.resx becomes
         Marquee.Host.Resources.Strings, the name Strings.cs looks up, and Strings.de.resx its German satellite, the same
         way the CLI names its own. -->
    <RootNamespace>Marquee.Host</RootNamespace>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <!-- The engine has no UI: no preview and no WinForms here, so the windowless tray app can host it as it is. -->
  <ItemGroup>
    <ProjectReference Include="..\Marquee.Core\Marquee.Core.csproj" />
    <ProjectReference Include="..\Marquee.Providers.Hardware\Marquee.Providers.Hardware.csproj" />
    <ProjectReference Include="..\Marquee.Providers.Agents\Marquee.Providers.Agents.csproj" />
    <ProjectReference Include="..\Marquee.Providers.Custom\Marquee.Providers.Custom.csproj" />
    <ProjectReference Include="..\Marquee.Providers.Fps\Marquee.Providers.Fps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only for Microsoft.Win32.SystemEvents, which says when the time zone or regional format changes
         (ClockSettingsWatch). It adds nothing at run time: the tray and the CLI already load Windows Desktop for WinForms. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The public key updates must be signed with (ReleaseKey). A fixed resource name, so moving the file doesn't
         change the lookup. -->
    <EmbeddedResource Include="Updates\release-key.pub.pem" LogicalName="release-key.pub.pem" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Marquee.Host.Tests" />
  </ItemGroup>
</Project>
