// @name Starfield
// @control tint colour "Colour" default #36D1DC
// @control speed number 0.1..3 default 1 "Speed"
// @control strength number 0..1 default 0.8 "Strength"
// @reacts heat "Warmer and brighter as it gets busy"
uniform float time;
uniform float2 resolution;
uniform float3 tint;
uniform float speed;
uniform float strength;
uniform float heat;

half4 main(float2 p) {
    float2 uv = p / resolution;
    float t = time * speed * 0.3;
    float warmth = clamp(heat, 0.0, 1.0);
    float2 cell = floor(uv * float2(32.0, 8.0)); float seed = fract(sin(dot(cell, float2(12.9898, 78.233))) * 43758.5453); float2 local = fract(uv * float2(32.0, 8.0)) - 0.5; float glow = 0.03 + (1.0 - smoothstep(0.0, 0.14, length(local))) * (0.5 + 0.5 * sin(t + seed * 6.28)) * (0.6 + warmth);
    float3 color = mix(tint, float3(1.0, 0.35, 0.21), warmth) * glow * strength * (0.65 + 0.3 * warmth);
    return half4(half3(color), 1.0);
}
